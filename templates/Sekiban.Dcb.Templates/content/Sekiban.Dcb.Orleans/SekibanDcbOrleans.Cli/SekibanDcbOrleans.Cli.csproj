<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)..\SekibanDcbTemplateVersion.props" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>5ef4f3d0-a98f-43cb-b8ba-2b6a6281c6e6</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.64.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.15" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
        <PackageReference Include="System.CommandLine" Version="2.0.15" />
        <PackageReference Include="Sekiban.Dcb.WithResult" Version="$(SekibanDcbVersion)" />
        <PackageReference Include="Sekiban.Dcb.Postgres" Version="$(SekibanDcbVersion)" />
        <PackageReference Include="Sekiban.Dcb.CosmosDb" Version="$(SekibanDcbVersion)" />
        <PackageReference Include="Sekiban.Dcb.Sqlite" Version="$(SekibanDcbVersion)" />
        <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.103" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SekibanDcbOrleans.Domain\SekibanDcbOrleans.Domain.csproj"/>
    </ItemGroup>

</Project>
