<Project Sdk="Microsoft.NET.Sdk">

    <!--
      This fixture deliberately compiles against the published pre-SEK-G53 contract. It must load with the current
      runtime after ITagStateProjectionAccumulator gains its default ApplyEvent member.
    -->
    <PropertyGroup>
        <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
        <LangVersion>preview</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <GenerateSBOM>false</GenerateSBOM>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Sekiban.Dcb.Core" Version="10.18.0" />
        <PackageReference Include="Sekiban.Dcb.Core.Model" Version="10.18.0" />
    </ItemGroup>

</Project>
