<Project>
  <PropertyGroup Label="SEK-G49 core target framework and package-version authority">
    <!-- Slice B moves the forty in-scope core projects to a single net10.0 target. -->
    <SekibanCoreNet9TargetFramework>net10.0</SekibanCoreNet9TargetFramework>
    <SekibanCoreNet8Net9TargetFrameworks>net10.0</SekibanCoreNet8Net9TargetFrameworks>
    <SekibanCoreNet9Net8TargetFrameworks>net10.0</SekibanCoreNet9Net8TargetFrameworks>
    <SekibanCorePackageVersion>0.25.0</SekibanCorePackageVersion>
  </PropertyGroup>
</Project>
